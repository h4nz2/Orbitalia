{
	// Cloudflare Workers static assets: serves the Vite build, SPA fallback for deep links.
	"name": "orbitalia",
	"compatibility_date": "2026-09-24",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
	},
	"routes": [{ "pattern": "orbitalia.app", "custom_domain": true }],
}
