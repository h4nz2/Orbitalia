{
	"name": "orbitalia",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:data": "tsx scripts/build-bodies.ts",
		"check:data": "pnpm build:data && git diff --exit-code -- src/data/bodies.json src/data/credits.json src/data/belts.json",
		"build:spacecraft": "tsx scripts/build-spacecraft.ts",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"gen:rings": "tsx scripts/gen-ring-textures.ts",
		"prepare": "husky",
		"gen:surfaces": "tsx scripts/gen-moon-surfaces.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@tanstack/router-plugin": "^1.168.40",
		"@types/node": "^22.20.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"postcss": "^8.5.28",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.9",
		"sharp": "0.35.4",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.137.0"
	},
	"dependencies": {
		"@mantine/core": "^9.6.2",
		"@mantine/dates": "^9.6.2",
		"@mantine/hooks": "^9.6.2",
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.8.0",
		"@react-three/postprocessing": "^3.1.2",
		"@tabler/icons-react": "^3.48.0",
		"@tanstack/react-router": "^1.170.38",
		"astronomy-engine": "^2.1.19",
		"dayjs": "^1.11.23",
		"gsap": "^3.15.0",
		"intl-messageformat": "^12.1.2",
		"postprocessing": "^6.39.5",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"three": "^0.186.0",
		"uqr": "0.1.3",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	}
}
