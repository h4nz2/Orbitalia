{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["vite/client", "node"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"src",
		"e2e",
		"scripts",
		"worker",
		"vite.config.ts",
		"playwright.config.ts"
	]
}
